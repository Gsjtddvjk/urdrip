# URDRIP — server-side configuration (NEVER commit this file)
# Copy to ".env" and fill in. Read by server.js locally; on Vercel set the
# same variables in Project Settings -> Environment Variables.

# --- Supabase (server side only, never exposed to the browser) ---
SUPABASE_URL=https://vmsrldkihpxkfbgvswnf.supabase.co
SUPABASE_ANON_KEY=

# Optional: only needed for the PASSWORD-based admin login.
# Supabase -> Project Settings -> API -> service_role (rotate the old one first).
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin access ---
# Password for the dashboard when logging in with a password instead of a
# Supabase Auth account. Strong, unique, and never committed.
ADMIN_PASSWORD=

# Secret used to sign the server-side admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
